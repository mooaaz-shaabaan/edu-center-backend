# ─────────────────────────────────────────────────────────
# متغيرات السيرفر العام (Render / أي استضافة)
#
# ⚠ الملف ده **مثال** — القيم الحقيقية بتتحط في لوحة الاستضافة،
#   مش في ملف جوه الريبو. أي سر يتكتب هنا يبقى في Git للأبد.
# ─────────────────────────────────────────────────────────

NODE_ENV=production

# ── الداتابيز (Neon) ──────────────────────────────────────
# من Neon → Connection string → **Pooled connection**
# ⚠ لازم تنتهي بـ `?sslmode=require` — Neon مابيقبلش من غيرها.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ── الدخول ────────────────────────────────────────────────
# ⚠ سر جديد طويل وعشوائي — **مش** اللي على جهازك.
#   ولّده بـ:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── روابط الطلاب ──────────────────────────────────────────
# ⚠ ده اللي بيتحط جوه الـQR وبيتبعت لولي الأمر. لازم يبقى الرابط
#   العام للسيرفر، من غير / في الآخر.
PORTAL_BASE_URL=https://markazi-api.onrender.com

# المتصفحات المسموح لها تنادي الـAPI (مفصولة بفواصل).
# صفحات الطالب نفس الأصل فمش محتاجة إذن، بس سيبها مظبوطة.
ALLOWED_ORIGINS=https://markazi-api.onrender.com

# ── الباك أب ──────────────────────────────────────────────
# ⚠ false على الاستضافة المجانية: الهارد بيتمسح مع كل نشر
#   و`pg_dump` مش متسطّب. الاعتماد على باك أب Neon.
BACKUP_ENABLED=false

# ── حساب المالك الأول (للـ seed مرة واحدة بس) ─────────────
# ⚠ من غيرهم الـseed بيرفض يشتغل على NODE_ENV=production،
#   عشان الباسورد الافتراضي مكتوب في الريبو.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
